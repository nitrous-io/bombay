#!/usr/bin/env ruby

lib = File.expand_path(File.dirname(__FILE__) + '/../lib')
$LOAD_PATH.unshift(lib) if File.directory?(lib) && !$LOAD_PATH.include?(lib)

require 'rubygems'
require 'commander/import'
require 'bombay'

require 'yaml'

ANSIBLE_VERSION = '0.7.1'.freeze

program :version, Bombay::VERSION
program :description, 'bombay - anything is possible with bombay'

def set_aws_credentials!
  unless Bombay::AwsAuthenticator.load_credentials!
    access_key = ask "AWS Access Key ID: "
    secret_key = password "AWS Secret Key: "

    Bombay::AwsAuthenticator.set_credentials!(access_key, secret_key)
  end
end

def pick_region_from(servers_by_region)
  picked_region = nil

  if servers_by_region.count > 1
    while servers_by_region[picked_region].nil?
      picked_region = ask "Pick a region from #{servers_by_region.keys.join(',')}: "
    end
  else
    picked_region = servers_by_region.keys.first
  end

  picked_region
end

def pick_environment_from(environments)
  picked_environment = nil

  if environments.count > 1
    while environments[picked_environment].nil?
      picked_environment = ask "Pick an environment from #{environments.keys.join(',')}: "
    end
  else
    picked_environment = environments.keys.first
  end

  picked_environment
end

command :setup do |c|
  c.syntax = 'bombay setup'
  c.summary = 'Setups all the requirements for bombay to work (ansible, etc.)'
  c.description = 'Setups all the requirements for bombay to work (ansible, etc.)'
  c.example 'Usage', c.syntax

  c.action do
    puts "Installing ansible dependencies"
    system("sudo apt-get -yy install python-paramiko python-yaml python-jinja2 python-simplejson")
    puts "Downloading ansible #{ANSIBLE_VERSION} from Github..."
    system("wget https://github.com/downloads/ansible/ansible/ansible-#{ANSIBLE_VERSION}.tar.gz --output-document=/tmp/ansible-#{ANSIBLE_VERSION}.tar.gz --quiet")
    puts "Expanding ansible #{ANSIBLE_VERSION}"
    system("tar -zxvf /tmp/ansible-#{ANSIBLE_VERSION}.tar.gz --directory=/tmp")
    puts "Setting up ansible #{ANSIBLE_VERSION}..."
    install_status = system("cd /tmp/ansible-#{ANSIBLE_VERSION} && sudo python setup.py install")
    puts install_status ? "** Done **" : "** Failed **"
  end
end

command :build do |c|
  c.syntax = "bombay build server|container name"
  c.summary = "Build containers and/or servers"
  c.description = c.summary
  c.example 'Usage', c.syntax

  c.action do |args, options|
    if args.length != 2
      puts "Usage: #{c.syntax}"
    else
      type, name = args

      if type == 'server'
        if !File.exists?(File.join("ansible", "servers", name, "plays", "main.yml"))
          puts "** Error: Could not find a play for server #{name} in ansible/servers"
          exit(1)
        end

        set_aws_credentials!
        # Check for server config in servers/#{name}/config.yml
        servers_by_region = Bombay::Server.initialize_role(name)
        # Prompt for region
        region = pick_region_from(servers_by_region)
        puts "** Picked Region: #{region}\n"

        # Prompt for environment
        environment = pick_environment_from(servers_by_region[region])
        puts "** Picked Environment: #{environment}\n"

        servers = servers_by_region[region][environment]

        begin
          Bombay::SecurityGroup.get_all_for(region).each { |sg| sg.create! }
          # Check if server exists in AWS in that region
          # If not, provision, once provisioned,
          servers.each { |s| s.provision! unless s.exists? }
        rescue Fog::Service::Error => e
          if e.to_s =~ /AuthFailure/
            puts "** Error: Your AWS Credentials are invalid, please try again."
            Bombay::AwsAuthenticator.clear_credentials!
          else
            raise e
          end
        end

        # run ansible playbooks
        begin
          Bombay::Server.setup_sensitive_vars!(name, environment)
          Bombay::Server.build!(servers, region, environment)
        rescue Bombay::PrivateKeyDoesNotExistError => e
          puts "** Error: Private Key file for #{region} does not exist at #{e.message}"
        end
      elsif type == 'container'
        if !File.exists?(File.join("ansible", "containers", name, "plays", "main.yml"))
          puts "** Error: Could not find a play for container #{name} in ansible/containers"
          exit(1)
        end

        Bombay::Container.new(name: name).build!
      else
        puts "Usage: #{c.syntax}"
      end
    end
  end
end

command :deploy do |c|
  c.syntax = "bombay deploy container name --region region"
  c.summary = "Deploy container to an S3 bucket in a region"
  c.description = c.summary
  c.example 'Usage', c.syntax

  c.action do |args, options|
    if args.length != 2
      puts "Usage: #{c.syntax}"
    else
      if args[0] != 'container'
        puts "Usage: #{c.syntax}"
      else
        begin
          Bombay::Container.new(name: args[1]).deploy!
        rescue Bombay::ConfigFileMissingError
          puts "** Error: Couldn't find container #{args[1]}"
        end
      end
    end
  end
end
