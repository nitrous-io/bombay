#!/usr/bin/env ruby

lib = File.expand_path(File.dirname(__FILE__) + '/../lib')
$LOAD_PATH.unshift(lib) if File.directory?(lib) && !$LOAD_PATH.include?(lib)

require 'rubygems'
require 'bundler/setup'
require 'commander/import'
require 'bombay'

program :version, Bombay::VERSION
program :description, 'bombay - anything is possible with bombay'

command :setup do |c|
  c.syntax = 'bombay setup'
  c.summary = 'Setups all the requirements for bombay to work (ansible, etc.)'
  c.description = 'Setups all the requirements for bombay to work (ansible, etc.)'
  c.example 'Usage', c.syntax

  c.action { Bombay::Ansibler.setup }
end

command :build do |c|
  c.syntax = "bombay build container|template name <playbook>"
  c.summary = "Build containers and/or servers"
  c.description = c.summary
  c.example 'Usage', c.syntax
  c.option '--deploy'

  c.action do |args, options|
    if args.length < 2
      puts "Usage: #{c.syntax}"
      exit 1
    end

    type, role, playbook = args
    playbook ||= "main"

    case type
    when 'container'
      container = Bombay::Container.new(role, playbook)
      options.deploy ? container.deploy! : container.build!

    when 'template'
      template = Bombay::Template.new role, playbook
      options.deploy ? template.deploy! : template.build!
    end
  end
end
