files:
  {% if role == 'box_host' %}
- /var/apps/boxer/shared/log/boxer.log
  - /var/apps/proxee/shared/log/proxee.log
  {% elif role == 'rainbow' %}
- /var/apps/rainbow/shared/log/rainbow.log
  {% elif role == 'coach' %}
- /var/apps/coach/shared/log/coach.log
  {% endif %}

destination:
  host: logs.papertrailapp.com
  port: {{ papertrail_port }}
