# Created on 08/Jan/2013 22:40 SGT

chroot = /var/run/stunnel4/
pid = /stunnel.pid
setuid = stunnel4
setgid = stunnel4
cert = /etc/stunnel/certs/stunnel.pem
key = /etc/stunnel/keys/stunnel.key
options = NO_SSLv2
foreground = no
delay = yes

; Some performance tunings
socket = l:TCP_NODELAY=1
socket = r:TCP_NODELAY=1

; debugging
debug = 4
output = /stunnel.log

[https]
  accept  = {{ stunnel_port }}
  connect = 3001
  TIMEOUTclose = 0

; vim:ft=dosini
