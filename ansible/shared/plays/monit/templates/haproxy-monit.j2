check process haproxy with pidfile "/var/run/haproxy.pid"
  start program = "/etc/init.d/haproxy start"
  stop program = "/etc/init.d/haproxy stop"
  # CPU and MEMORY here means the process' usage of resources, not global resource use
  # loadavg on the other hand, is overall system load
  if cpu > 60% for 2 cycles then alert
  if cpu > 70% for 5 cycles then restart
  #if failed host localhost port 80 protocol http
     #and request {{ haproxy_healthcheck_url }}
     #then restart
