# mem limit for redis is high, like 90%
{% set memlimit = ansible_memtotal_mb * 90 / 100 %}

# load_alert_5min is double the processor count
# stable_load_avg == processor_count
# I.E, 1 processor and 1.00 1min loadavg equals 100% CPU utilization
# Anything higher is a cause for alarm. 180-200% CPU should critical (noticeable slowness).

{% set load_alert_5min = ansible_processor_count * 2 %}

check process redis with pidfile "/var/run/redis/redis-server.pid "
  start program = "/etc/init.d/redis-server start"
  stop program = "/etc/init.d/redis-server stop"
  if cpu > 60% for 2 cycles then alert
  if cpu > 70% for 5 cycles then restart
  if totalmem > {{ memlimit }} MB for 5 cycles then alert
  if failed host localhost port 65000 then restart
