# mem limit is 60%
{% set memlimit = ansible_memtotal_mb * 60 / 100 %}

check process statsd with pidfile "/var/run/statsd.pid"
  start program = "/sbin/start statsd"
  stop program = "/sbin/stop statsd"
  # CPU and MEMORY here means the process' usage of resources, not global resource use
  # loadavg on the other hand, is overall system load
  if cpu > 60% for 2 cycles then alert
  if cpu > 70% for 5 cycles then restart
  if failed host localhost port {{ statsd_port }} type udp then restart
  if totalmem > {{ memlimit }} MB for 5 cycles then restart

