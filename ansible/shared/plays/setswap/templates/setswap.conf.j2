# setswap - An init script which setups swap
#

description "Set Swap"

start on mounted MOUNTPOINT=/mnt
stop on [!12345]

script
    if [ ! -f /mnt/swap ]; then
        dd if=/dev/zero of=/mnt/swap bs=8M count=1024
        mkswap /mnt/swap
        swapon /mnt/swap
        echo 'Created Swap File & Enabled It'
    fi
end script
