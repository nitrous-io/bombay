description "restart_aio_boxes"
author      "{{ deploy_user }}"

start on runlevel [2345]
stop on runlevel [!2345]

# Redirect stdout/stderr to /var/log/upstart/<job>.log
console log

script
  exec sudo su {{ deploy_user }} bash -c 'source /home/{{ deploy_user }}/.nvm/nvm.sh && cd /var/apps/boxer/current && export $(cat .env) && node init.js'
end script

